generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Source {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  url           String
  scrapeType    ScrapeType
  category      SourceCategory @default(AGGREGATOR)
  lastScrapedAt DateTime?
  enabled       Boolean        @default(true)
  events        Event[]
  createdAt     DateTime       @default(now())

  @@map("sources")
}

model Event {
  id           String         @id @default(cuid())
  externalId   String?
  dedupeHash   String         @unique
  title        String
  description  String?
  startDate    DateTime
  endDate      DateTime?
  venueName    String?
  venueAddress String?
  city         String         @default("San Francisco")
  neighborhood String?
  latitude     Float?
  longitude    Float?
  category     EventCategory?
  categoryRaw  String?
  price        String?
  isFree       Boolean        @default(false)
  imageUrl     String?
  sourceUrl    String
  tags         String[]
  status        EventStatus    @default(PUBLISHED)
  submitterNote String?
  geocoded      Boolean        @default(false)
  categorized   Boolean        @default(false)
  sourceId      String
  source       Source         @relation(fields: [sourceId], references: [id])
  featured     Boolean        @default(false)
  featuredAt   DateTime?
  scrapedAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  interactions EventInteraction[]

  @@index([startDate])
  @@index([neighborhood])
  @@index([category])
  @@index([sourceId])
  @@index([startDate, neighborhood, category])
  @@index([status])
  @@index([status, featured, featuredAt])
  @@map("events")
}

enum InteractionType {
  VIEW
  CLICK
}

model EventInteraction {
  id        String          @id @default(cuid())
  eventId   String
  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type      InteractionType
  sessionId String
  createdAt DateTime        @default(now())

  @@index([eventId])
  @@index([eventId, type])
  @@index([createdAt])
  @@map("event_interactions")
}

model BugReport {
  id          String   @id @default(cuid())
  description String
  pageUrl     String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@map("bug_reports")
}

enum FeaturedRequestStatus {
  NEW
  CONTACTED
  CLOSED
}

model FeaturedRequest {
  id        String                @id @default(cuid())
  name      String
  email     String
  eventName String
  eventDate String?
  eventUrl  String?
  message   String
  status    FeaturedRequestStatus @default(NEW)
  createdAt DateTime              @default(now())

  @@map("featured_requests")
}

enum SubmissionOutcome {
  CREATED
  DUPLICATE
  ERROR
}

model Submission {
  id                String             @id @default(cuid())
  title             String
  startDate         DateTime?
  outcome           SubmissionOutcome
  eventId           String?
  submitterNote     String?
  unknownSourceUrl  String?
  createdAt         DateTime           @default(now())

  @@index([createdAt])
  @@map("submissions")
}

model PageVisit {
  id        String   @id @default(cuid())
  sessionId String
  path      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([sessionId])
  @@map("page_visits")
}

model InstagramSeenPost {
  shortCode String   @id
  seenAt    DateTime @default(now())

  @@map("instagram_seen_posts")
}

model EventBlocklist {
  id         String   @id @default(cuid())
  dedupeHash String?  @unique
  sourceUrl  String?  @unique
  title      String
  reason     String?
  createdAt  DateTime @default(now())

  @@map("event_blocklist")
}

enum ScrapeType {
  CHEERIO
  PLAYWRIGHT
  API
  MANUAL
}

enum SourceCategory {
  AGGREGATOR    // Multi-venue discovery sites (Eventbrite, Luma, Foopee, etc.)
  VENUE         // Single venue's own event page
  INSTITUTIONAL // Government/library/park systems
  COMMUNITY     // User-generated (Reddit, community submissions)
}

enum EventStatus {
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum EventCategory {
  MUSIC_ELECTRONIC
  MUSIC_ROCK_PUNK
  MUSIC_JAZZ_BLUES
  MUSIC_HIPHOP
  MUSIC_RNB_SOUL
  MUSIC_CLASSICAL
  MUSIC_OTHER
  ART_GALLERY
  ART_PERFORMANCE
  COMEDY
  FOOD_DRINK
  NIGHTLIFE
  COMMUNITY
  TECH
  TALKS_LECTURES
  SPORTS_FITNESS
  FILM
  THEATER
  OUTDOOR
  FAMILY
  OTHER
}
