generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Source {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  url           String
  scrapeType    ScrapeType
  category      SourceCategory @default(AGGREGATOR)
  lastScrapedAt DateTime?
  enabled       Boolean        @default(true)
  events        Event[]
  runs          ScrapeRun[]
  createdAt     DateTime       @default(now())

  @@map("sources")
}

// Per-run scraper outcome log (issue #101). One row per source per
// runScraper() call — success or failure, with the error message when it
// failed — so the admin scrapers panel can show *why* a source went dark
// without needing shell access. Pruned to the most recent SCRAPE_RUN_HISTORY
// rows per source on write (see lib/scrapers/runner.ts) to bound growth.
model ScrapeRun {
  id        String   @id @default(cuid())
  sourceId  String
  source    Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  ok        Boolean
  scraped   Int      @default(0)
  inserted  Int      @default(0)
  error     String?
  createdAt DateTime @default(now())

  @@index([sourceId, createdAt])
  @@map("scrape_runs")
}

model Event {
  id               String             @id @default(cuid())
  externalId       String?
  dedupeHash       String             @unique
  title            String
  description      String?
  startDate        DateTime
  endDate          DateTime?
  allDay           Boolean            @default(false)
  venueName        String?
  venueAddress     String?
  // Nullable FK to the normalized Venue table. Resolved at ingest (after
  // geocoding) when venueName matches a known venue (lib/venues.ts); free-text
  // venueName remains the source of truth for everything else. See Venue.
  venueId          String?
  venue            Venue?             @relation(fields: [venueId], references: [id])
  city             String             @default("San Francisco")
  neighborhood     String?
  latitude         Float?
  longitude        Float?
  category         EventCategory?
  price            String?
  isFree           Boolean            @default(false)
  imageUrl         String?
  sourceUrl        String
  tags             String[]
  performers       String[]
  status           EventStatus        @default(PUBLISHED)
  submitterNote    String?
  geocoded         Boolean            @default(false)
  categorized      Boolean            @default(false)
  sourceId         String
  source           Source             @relation(fields: [sourceId], references: [id])
  featured         Boolean            @default(false)
  featuredAt       DateTime?
  // One-line "why we picked it" hook shown on the featured card and in a
  // highlighted block on the detail page. Generated by the featured-enrichment
  // pass (lib/enrichFeatured.ts) and filled once, then kept stable across runs.
  featuredBlurb    String?
  recurringType    RecurringType?
  // Reliable popularity signal pulled from the source (e.g. Resident Advisor's
  // "interested" count). Distinct from EventInterest (anonymous in-app votes);
  // folded into the displayed heart count and used as a curation signal.
  externalInterest Int                @default(0)
  scrapedAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  // Semantic-merge bookkeeping. When duplicates are merged, losers are ARCHIVED
  // and point at the survivor via mergedIntoId (its /events/<id> URL 301s to the
  // survivor). The survivor records mergeProvenance: which source(s) contributed.
  mergedIntoId     String?
  mergeProvenance  Json?
  // Soft delete (issue #103). Admin "delete" sets status → TRASHED and stamps
  // deletedAt instead of removing the row, so a mis-click is recoverable from the
  // trash UI. A periodic purge (scripts/purge-trashed-events.ts) hard-deletes
  // rows trashed more than the retention window ago.
  deletedAt        DateTime?
  interactions     EventInteraction[]
  interests        EventInterest[]
  reports          EventReport[]

  @@index([startDate])
  @@index([neighborhood])
  @@index([category])
  @@index([sourceId])
  @@index([startDate, neighborhood, category])
  @@index([status])
  @@index([status, startDate, featured])
  @@index([status, featured, featuredAt])
  @@index([mergedIntoId])
  @@index([status, deletedAt])
  @@index([venueId])
  @@map("events")
}

// Normalized venue, seeded from the static known-venue table (lib/venues.ts).
// Collapses the many free-text spellings of a venue ("Exploratorium" / "The
// Exploratorium" / "Exploratorium SF") onto one row so grouping, venue stats,
// mini-maps, and venue-follow can key off a stable id instead of a name. `slug`
// is the deterministic natural key (slugifyVenue(name)) used to upsert idempotently.
model Venue {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  address   String?
  latitude  Float?
  longitude Float?
  photoUrl  String?
  events    Event[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("venues")
}

enum InteractionType {
  VIEW
  CLICK
}

model EventInteraction {
  id        String          @id @default(cuid())
  eventId   String
  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type      InteractionType
  sessionId String
  createdAt DateTime        @default(now())

  @@index([eventId])
  @@index([eventId, type])
  @@index([createdAt])
  // Per-session preference vectors (#99) read history by sessionId.
  @@index([sessionId])
  @@map("event_interactions")
}

/// Anonymous, per-session interest votes ("I'm interested") on any event.
/// One row per (event, session); presence = an active vote. Unlike
/// EventInteraction (append-only VIEW/CLICK, featured-only), this is a
/// toggleable demand signal captured across ALL events to inform curation.
model EventInterest {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sessionId String
  // Set when an anonymous session's votes are claimed by an account on first
  // login (issue #96). Null = still anonymous. Nullable on user delete so the
  // anonymous demand signal survives account deletion.
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([eventId, sessionId])
  @@index([eventId])
  @@index([userId])
  // Per-session preference vectors (#99) read history by sessionId; the
  // [eventId, sessionId] unique index can't serve a sessionId-only lookup.
  @@index([sessionId])
  @@map("event_interests")
}

/// Triage status shared by bug reports and event reports (issue #104).
/// Unresolved = NEW or IN_PROGRESS; these drive the admin nav badge counts.
enum ReportStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

/// Records duplicate candidate pairs an admin marked "not a duplicate" (issue
/// #102), so the dedup review UI stops re-surfacing them. Keyed by the two event
/// ids sorted lexicographically (`${minId}:${maxId}`) so order doesn't matter.
model DuplicatePairDismissal {
  id        String   @id @default(cuid())
  pairKey   String   @unique
  createdAt DateTime @default(now())

  @@map("duplicate_pair_dismissals")
}

/// Persisted output of the nightly LLM duplicate adjudicator (scripts/merge-dups.ts).
/// One row per candidate pair the adjudicator has judged, keyed by the two event ids
/// sorted lexicographically (`${minId}:${maxId}`). This lets the admin dedup UI show
/// only the *uncertain* band — pairs it leaned toward "duplicate" but scored below the
/// auto-merge confidence — instead of the raw blocking firehose (thousands of pairs),
/// and lets the cron skip re-judging settled pairs. Errored adjudications (missing key
/// / rate-limit) are deliberately NOT written, so a transient failure can never be
/// cached as a false "not a duplicate". Re-judging a pair replaces its row.
model DuplicateVerdict {
  id         String   @id @default(cuid())
  pairKey    String   @unique
  same       Boolean
  confidence Float
  reason     String
  model      String
  judgedAt   DateTime @default(now())

  @@index([same, confidence])
  @@map("duplicate_verdicts")
}

model BugReport {
  id          String       @id @default(cuid())
  description String
  email       String?
  pageUrl     String?
  userAgent   String?
  status      ReportStatus @default(NEW)
  createdAt   DateTime     @default(now())

  @@index([status])
  @@map("bug_reports")
}

model EventReport {
  id        String       @id @default(cuid())
  eventId   String
  event     Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  comment   String?
  email     String?
  status    ReportStatus @default(NEW)
  createdAt DateTime     @default(now())

  @@index([eventId])
  @@index([status])
  @@map("event_reports")
}

enum FeaturedRequestStatus {
  NEW
  CONTACTED
  CLOSED
}

model FeaturedRequest {
  id             String                @id @default(cuid())
  name           String
  email          String
  eventName      String
  eventDate      String?
  eventUrl       String?
  message        String
  eventId        String?
  suggestedEdits Json?
  status         FeaturedRequestStatus @default(NEW)
  createdAt      DateTime              @default(now())

  @@map("featured_requests")
}

enum SubmissionOutcome {
  CREATED
  DUPLICATE
  ERROR
}

model Submission {
  id               String            @id @default(cuid())
  title            String
  startDate        DateTime?
  outcome          SubmissionOutcome
  eventId          String?
  submitterNote    String?
  unknownSourceUrl String?
  createdAt        DateTime          @default(now())

  @@index([createdAt])
  @@map("submissions")
}

model PageVisit {
  id        String   @id @default(cuid())
  sessionId String
  path      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([sessionId])
  @@map("page_visits")
}

model InstagramSeenPost {
  shortCode String   @id
  seenAt    DateTime @default(now())

  @@map("instagram_seen_posts")
}

model SpotifySession {
  id           String   @id @default(cuid())
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  artists      String[]
  artistCount  Int      @default(0)
  synced       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("spotify_sessions")
}

model EventBlocklist {
  id         String   @id @default(cuid())
  dedupeHash String?  @unique
  sourceUrl  String?  @unique
  title      String
  reason     String?
  createdAt  DateTime @default(now())

  @@map("event_blocklist")
}

model CurationInsight {
  id        String   @id @default(cuid())
  weekOf    DateTime @unique
  insight   String   @db.Text
  topEvents Json
  createdAt DateTime @default(now())

  @@index([weekOf])
  @@map("curation_insights")
}

model CostEntry {
  id           String      @id @default(cuid())
  service      CostService
  amount       Float
  billingMonth DateTime // first day of the billing month (UTC)
  notes        String?
  createdAt    DateTime    @default(now())

  @@index([billingMonth])
  @@index([service])
  @@map("cost_entries")
}

enum CostService {
  CLAUDE_CODE
  CLAUDE_API
  APIFY
  RAILWAY
  OTHER
}

enum UserRole {
  ADMIN
  EDITOR
  USER
}

model User {
  id        String          @id @default(cuid())
  email     String          @unique
  name      String?
  // Self-serve magic-link signups default to USER (issue #96). EDITOR/ADMIN are
  // granted explicitly by an admin via the users admin page.
  role      UserRole        @default(USER)
  // Weekly "this weekend in SF" digest (issue #97). Accounts are opted in by
  // default — signing up is the consent — and opt out via the one-click
  // unsubscribe link in every email (no login required, so the token is the
  // capability). unsubscribeToken is minted lazily on first send (null until
  // then); lastDigestSentAt guards against double-sends within a week and aids
  // observability.
  digestOptIn      Boolean   @default(true)
  unsubscribeToken String?   @unique
  lastDigestSentAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  sessions  UserSession[]
  auditLogs AdminAuditLog[]
  interests EventInterest[]
  follows   Follow[]

  @@map("users")
}

enum FollowTargetType {
  VENUE
  CATEGORY
  ARTIST
}

// A user's standing interest in a venue, category, or artist (issue #98). Feeds
// the "following" page and, later, the weekly email digest (#97). One row per
// (user, type, target); presence = an active follow.
//
// targetId is polymorphic by targetType:
//   VENUE    → Venue.id (only normalized venues are followable; see lib/venues.ts)
//   CATEGORY → an EventCategory enum name, e.g. "MUSIC_ELECTRONIC"
//   ARTIST   → a lowercased artist display name, matched the same way the Spotify
//              "for you" feed does (lib/artistMatch.ts): a performer hit, or a
//              word-boundary title hit on music events
model Follow {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType FollowTargetType
  targetId   String
  createdAt  DateTime         @default(now())

  @@unique([userId, targetType, targetId])
  @@index([userId])
  @@index([targetType, targetId])
  @@map("follows")
}

// Append-only record of admin actions (approve/reject/feature/delete/etc.) for
// per-user accountability. actorEmail is denormalized so the trail survives
// deletion of the acting user (userId is nulled on user delete).
model AdminAuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorEmail String
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@map("admin_audit_logs")
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@map("user_sessions")
}

model MagicLinkToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@map("magic_link_tokens")
}

enum ScrapeType {
  CHEERIO
  PLAYWRIGHT
  API
  MANUAL
}

enum SourceCategory {
  AGGREGATOR // Multi-venue discovery sites (Eventbrite, Luma, Foopee, etc.)
  VENUE // Single venue's own event page
  INSTITUTIONAL // Government/library/park systems
  COMMUNITY // User-generated (Reddit, community submissions)
}

enum EventStatus {
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
  // Soft-deleted by an admin (issue #103). Excluded from all public queries
  // (which filter status = PUBLISHED); restorable from the trash UI until purged.
  TRASHED
}

enum RecurringType {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  ANNUAL
}

enum EventCategory {
  MUSIC_ELECTRONIC
  MUSIC_ROCK_PUNK
  MUSIC_JAZZ_BLUES
  MUSIC_HIPHOP
  MUSIC_RNB_SOUL
  MUSIC_CLASSICAL
  MUSIC_OTHER
  ART_GALLERY
  ART_PERFORMANCE
  ART_WORKSHOP
  COMEDY
  TRIVIA_BINGO
  FOOD_DRINK
  NIGHTLIFE
  COMMUNITY
  TECH
  TALKS_LECTURES
  SPORTS_FITNESS
  FILM
  THEATER
  OUTDOOR
  FAMILY
  OTHER
}
