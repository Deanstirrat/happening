FROM node:22-bookworm-slim

WORKDIR /app

# OpenSSL is required by Prisma at runtime
RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

# Copy package manifests and prisma schema before npm ci so postinstall
# (prisma generate) can run. SKIP_PLAYWRIGHT=1 prevents playwright from
# downloading Chromium — the web service doesn't need it.
COPY package*.json ./
COPY prisma ./prisma/
COPY prisma.config.ts ./

ENV SKIP_PLAYWRIGHT=1
RUN npm ci

COPY . .

# next build produces .next/standalone; postbuild copies static assets into it
RUN npm run build

EXPOSE 3000

# start.sh: runs prisma migrate deploy, then node .next/standalone/server.js
CMD ["sh", "scripts/start.sh"]
